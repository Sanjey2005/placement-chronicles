# Supply-chain hardening. npm worms (Shai-Hulud, ChainDrop, ...) run their payload from an install
# script, so no package runs code while installing. Nothing here needs one: onnxruntime-node ships
# its CPU binary in the tarball (its script only fetched unused CUDA files from NuGet), and
# `npm run build` still runs scripts/fetch-model.mjs because it is called explicitly.
ignore-scripts=true
# Only pick versions published a week ago or more; hijacked releases are usually pulled within days.
# `npm ci` installs the lockfile as is, so this only affects `npm install <pkg>` / `npm update`.
min-release-age=7
# Dependencies come from the registry (with lockfile integrity hashes), never from git URLs.
allow-git=none
save-exact=true
